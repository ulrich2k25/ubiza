generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS — USERS
// ======================================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ======================================================
// ENUMS — LISTINGS
// ======================================================

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  REJECTED
  DELETED
}

// ======================================================
// ENUMS — MODERATION
// ======================================================

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  FAKE_LISTING
  HARASSMENT
  DUPLICATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

// ======================================================
// ENUMS — COMMUNICATION
// ======================================================

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  ACCOUNT
  LISTING
  FAVORITE
  REVIEW
  MESSAGE
  REPORT
  BOOST
  AMBASSADOR
  REFERRAL
  PAYOUT
  SYSTEM
}

// ======================================================
// ENUMS — BUSINESS
// ======================================================

enum BoostStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BoostSource {
  REFERRAL_CREDIT
  PURCHASE
  ADMIN
}

enum PremiumPlan {
  TRIAL_7_DAYS
  DAY_1
  DAYS_7
  DAYS_30
}

enum PremiumSource {
  TRIAL
  PURCHASE
  ADMIN
}

enum PremiumSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  KPAY
  CINETPAY
  MANUAL
}

enum PaymentPurpose {
  PREMIUM
  BOOST
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

// ======================================================
// ENUMS — AI
// ======================================================

enum AIFeature {
  DESCRIPTION_GENERATION
  IMAGE_ENHANCEMENT
  FACE_BLUR
  PROFILE_QUALITY_SCORE
}

enum AIRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TrustLevel {
  NEW
  BASIC
  TRUSTED
  RESTRICTED
}

enum ContactAccessStatus {
  GRANTED
  DENIED
  BLOCKED
}

enum ContactMethod {
  PHONE
  WHATSAPP
  TELEGRAM
  INSTAGRAM
}

// ======================================================
// TABLES DE RÉFÉRENCE
// ======================================================

model Language {
  id         String  @id @default(cuid())
  name       String
  code       String  @unique
  nativeName String
  isActive   Boolean @default(true)

  profiles Profile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Currency {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  symbol   String
  isActive Boolean @default(true)

  boosts               Boost[]
  premiumSubscriptions PremiumSubscription[]
  payments             Payment[]
  commissions          Commission[]
  payouts              Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model City {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  profiles Profile[]
  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ======================================================
// UTILISATEURS ET AUTHENTIFICATION
// ======================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  phoneVerifiedAt      DateTime?
  acceptedRulesAt      DateTime?
  contactAccessEnabled Boolean    @default(false)
  trustScore           Int        @default(0)
  trustLevel           TrustLevel @default(NEW)
  trustUpdatedAt       DateTime?
  // ===========================
  // Referral (MVP)
  // ===========================

  referralCode            String?   @unique
  referredById            String?
  boostCredits            Int       @default(0)
  referralRewardGrantedAt DateTime?

  // ===========================
  // Premium
  // ===========================

  premiumActiveUntil    DateTime?
  premiumTrialStartedAt DateTime?
  premiumTrialUsed      Boolean   @default(false)

  referredBy    User?  @relation("UserReferralNetwork", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[] @relation("UserReferralNetwork")

  profile  Profile?
  settings UserSettings?

  verificationTokens   VerificationToken[]
  listings             Listing[]
  stories              Story[]
  favorites            Favorite[]
  contactAccesses      ContactAccess[]
  premiumSubscriptions PremiumSubscription[]
  payments             Payment[]

  reviewsWritten  Review[] @relation("ReviewsWritten")
  reviewsReceived Review[] @relation("ReviewsReceived")

  reportsCreated  Report[] @relation("ReportsCreated")
  reportsReceived Report[] @relation("ReportsReceived")

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]

  notifications Notification[]
  contactClicks ContactClick[]

  ambassador Ambassador?
  referrals  Referral[]  @relation("ReferredUsers")

  aiRequests AIRequest[]
  aiUsage    AIUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@index([trustLevel])
  @@index([trustScore])
  @@index([contactAccessEnabled])
  @@index([referralCode])
  @@index([referredById])
  @@index([premiumActiveUntil])
  @@index([premiumTrialUsed])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  username    String? @unique
  displayName String
  avatarUrl   String?
  description String?

  phone     String?
  whatsapp  String?
  telegram  String?
  instagram String?

  cityId     String?
  languageId String?

  profileQualityScore Int?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  language Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([languageId])
  @@index([displayName])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  showPhone     Boolean @default(true)
  showWhatsapp  Boolean @default(true)
  showTelegram  Boolean @default(true)
  showInstagram Boolean @default(true)

  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  automaticFaceBlur Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id     String @id @default(cuid())
  userId String

  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

// ======================================================
// CATÉGORIES
// ======================================================

model Category {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  icon        String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  listings Listing[]

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@index([displayOrder])
}

// ======================================================
// ANNONCES
// ======================================================

model Listing {
  id String @id @default(cuid())

  userId           String
  categoryId       String
  cityId           String
  boostActiveUntil DateTime?

  title       String
  description String
  age         Int?

  status       ListingStatus @default(DRAFT)
  availableNow Boolean       @default(false)

  allowPhone     Boolean @default(true)
  allowWhatsapp  Boolean @default(true)
  allowTelegram  Boolean @default(true)
  allowInstagram Boolean @default(true)

  automaticFaceBlur Boolean @default(false)

  viewCount Int @default(0)

  publishedAt DateTime?
  pausedAt    DateTime?
  deletedAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  city     City     @relation(fields: [cityId], references: [id])

  images          ListingImage[]
  favorites       Favorite[]
  reviews         Review[]
  reports         Report[]
  conversations   Conversation[]
  contactClicks   ContactClick[]
  boosts          Boost[]
  aiRequests      AIRequest[]
  contactAccesses ContactAccess[]
  views           ListingView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([cityId])
  @@index([status])
  @@index([availableNow])
  @@index([publishedAt])
  @@index([createdAt])
}

model ListingView {
  id String @id @default(cuid())

  listingId  String
  visitorKey String

  viewedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([visitorKey])
  @@index([listingId, visitorKey, viewedAt])
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String

  url       String
  publicId  String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  faceBlurRequested Boolean @default(false)
  faceBlurApplied   Boolean @default(false)

  originalUrl String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, position])
  @@index([listingId])
  @@index([listingId, isPrimary])
}

model Story {
  id String @id @default(cuid())

  userId String

  imageUrl String
  publicId String?

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

// ======================================================
// FAVORIS, AVIS ET SIGNALEMENTS
// ======================================================

model Favorite {
  id        String @id @default(cuid())
  userId    String
  listingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model Review {
  id String @id @default(cuid())

  reviewerId     String
  reviewedUserId String
  listingId      String?

  rating  Int
  comment String?
  status  ReviewStatus @default(PUBLISHED)

  reviewer     User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User     @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewerId, reviewedUserId, listingId])
  @@index([reviewedUserId])
  @@index([listingId])
  @@index([status])
}

model Report {
  id String @id @default(cuid())

  reporterId     String
  listingId      String?
  reportedUserId String?

  reason  ReportReason
  details String?
  status  ReportStatus @default(PENDING)

  adminNote  String?
  resolvedAt DateTime?

  reporter     User     @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
}

model ContactClick {
  id String @id @default(cuid())

  userId    String?
  listingId String

  method String

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listingId])
  @@index([method])
  @@index([createdAt])
}

// ======================================================
// CHAT — DÉSACTIVÉ AU LANCEMENT
// ======================================================

model Conversation {
  id String @id @default(cuid())

  listingId String
  buyerId   String
  sellerId  String

  status ConversationStatus @default(ACTIVE)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId       String

  type     MessageType @default(TEXT)
  content  String
  imageUrl String?

  readAt    DateTime?
  deletedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

// ======================================================
// NOTIFICATIONS — DÉSACTIVÉES AU LANCEMENT
// ======================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  title   String
  message String
  data    Json?

  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}

// ======================================================
// BOOST — DÉSACTIVÉ AU LANCEMENT
// ======================================================

model Boost {
  id String @id @default(cuid())

  listingId String

  source BoostSource
  status BoostStatus @default(PENDING)

  durationMinutes Int

  // Utilisé uniquement pour les boosts obtenus avec des crédits
  creditCost Int @default(0)

  // Facultatifs, car un boost de parrainage est gratuit
  amount     Decimal? @db.Decimal(12, 2)
  currencyId String?

  // Facultatif : aucun paiement pour un boost par crédit
  paymentId String? @unique

  startsAt DateTime?
  endsAt   DateTime?

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  currency Currency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([source])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([startsAt, endsAt])
  @@index([currencyId])
}

model PremiumSubscription {
  id String @id @default(cuid())

  userId String

  plan   PremiumPlan
  source PremiumSource
  status PremiumSubscriptionStatus @default(PENDING)

  startsAt DateTime
  endsAt   DateTime

  // Null pour l’essai gratuit ou une activation administrateur
  amount     Decimal? @db.Decimal(12, 2)
  currencyId String?

  // Null pour l’essai gratuit ou une activation administrateur
  paymentId String? @unique

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([plan])
  @@index([source])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([userId, status])
  @@index([currencyId])
}

model Payment {
  id String @id @default(cuid())

  userId     String
  currencyId String

  provider PaymentProvider
  purpose  PaymentPurpose
  status   PaymentStatus   @default(PENDING)

  amount Decimal @db.Decimal(12, 2)

  // Identifiants reçus de KPay, CinetPay ou d’un autre fournisseur
  externalReference     String? @unique
  providerTransactionId String? @unique

  // Numéro Mobile Money utilisé, si le fournisseur le retourne
  customerPhone String?

  // Données techniques du fournisseur de paiement
  providerData Json?

  failureReason String?

  initiatedAt DateTime  @default(now())
  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])

  premiumSubscription PremiumSubscription?
  boost               Boost?
  commission          Commission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([purpose])
  @@index([status])
  @@index([currencyId])
  @@index([createdAt])
  @@index([userId, status])
}

// ======================================================
// AMBASSADEURS ET PARRAINAGE — DÉSACTIVÉS AU LANCEMENT
// ======================================================

model Ambassador {
  id     String @id @default(cuid())
  userId String @unique

  referralCode String           @unique
  status       AmbassadorStatus @default(PENDING)
  fullName          String?
mobileMoneyNumber String?
identityNumber    String?
country           String?
termsAcceptedAt   DateTime?

rejectionReason String?
rejectedAt      DateTime?

  approvedAt  DateTime?
  suspendedAt DateTime?

  identityVerifiedAt DateTime?
  identityVerificationRequestedAt DateTime?

  minimumPayout Decimal @default(5000) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  referrals   Referral[]
  commissions Commission[]
  payouts     Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Referral {
  id String @id @default(cuid())

  ambassadorId   String
  referredUserId String @unique

  status                       ReferralStatus @default(PENDING)
  validatedAt                  DateTime?
  firstPurchaseRewardGranted   Boolean        @default(false)
  firstPurchaseRewardGrantedAt DateTime?

  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredUser User       @relation("ReferredUsers", fields: [referredUserId], references: [id], onDelete: Cascade)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ambassadorId])
  @@index([status])
  @@index([firstPurchaseRewardGranted])
}

model Commission {
  id String @id @default(cuid())

  ambassadorId String
  referralId   String?
  currencyId   String
  paymentId    String? @unique

  amount Decimal          @db.Decimal(12, 2)
  status CommissionStatus @default(PENDING)

  description String?
  approvedAt  DateTime?
  paidAt      DateTime?

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referral   Referral?  @relation(fields: [referralId], references: [id], onDelete: SetNull)
  currency   Currency   @relation(fields: [currencyId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  payoutItems PayoutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ambassadorId])
  @@index([referralId])
  @@index([status])
}

model Payout {
  id String @id @default(cuid())

  ambassadorId String
  currencyId   String

  amount Decimal      @db.Decimal(12, 2)
  status PayoutStatus @default(PENDING)

  paymentMethod    String?
  paymentReference String?

  requestedAt   DateTime  @default(now())
  processedAt   DateTime?
  paidAt        DateTime?
  failureReason String?

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  currency   Currency   @relation(fields: [currencyId], references: [id])

  items PayoutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ambassadorId])
  @@index([status])
  @@index([requestedAt])
}

model PayoutItem {
  id String @id @default(cuid())

  payoutId     String
  commissionId String @unique

  payout     Payout     @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission Commission @relation(fields: [commissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([payoutId, commissionId])
  @@index([payoutId])
}

// ======================================================
// INTELLIGENCE ARTIFICIELLE — DÉSACTIVÉE AU LANCEMENT
// ======================================================

model AIRequest {
  id String @id @default(cuid())

  userId    String
  listingId String?

  feature AIFeature
  status  AIRequestStatus @default(PENDING)

  inputData  Json?
  outputData Json?

  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([feature])
  @@index([status])
  @@index([createdAt])
}

model AIUsage {
  id String @id @default(cuid())

  userId String

  feature AIFeature

  requestCount Int @default(0)
  inputUnits   Int @default(0)
  outputUnits  Int @default(0)

  periodStart DateTime
  periodEnd   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodStart, periodEnd])
  @@index([userId])
  @@index([feature])
}

model ContactAccess {
  id                 String              @id @default(cuid())
  requesterId        String
  listingId          String
  method             ContactMethod
  status             ContactAccessStatus @default(GRANTED)
  trustScoreSnapshot Int
  trustLevelSnapshot TrustLevel
  denialReason       String?
  grantedAt          DateTime?
  deniedAt           DateTime?
  createdAt          DateTime            @default(now())

  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
}
