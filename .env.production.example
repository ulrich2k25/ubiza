# ==================================================
# POSTGRESQL
# Utiliser uniquement des caractères alphanumériques
# pour éviter les problèmes d'encodage dans DATABASE_URL.
# ==================================================

POSTGRES_USER=ubiza
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET
POSTGRES_DB=ubiza_db


# ==================================================
# BACKEND
# ==================================================

FRONTEND_URL=https://votre-domaine.com
JWT_SECRET=REMPLACER_PAR_UN_SECRET_LONG

RESEND_API_KEY=
MAIL_FROM="Ubiza <noreply@votre-domaine.com>"


# ==================================================
# FRONTEND
# Ces valeurs sont intégrées au frontend pendant le build.
# Toute modification nécessite de reconstruire l'image.
# ==================================================

NEXT_PUBLIC_API_URL=https://api.votre-domaine.com
NEXT_PUBLIC_MANUAL_PAYMENT_MTN_NUMBER=
NEXT_PUBLIC_MANUAL_PAYMENT_ORANGE_NUMBER=

# ==================================================
# PAIEMENTS
# ==================================================

MANUAL_PAYMENT_SECRET=REMPLACER_PAR_UN_SECRET_LONG

PREMIUM_PRICE_DAY_1_XAF=500
PREMIUM_PRICE_DAYS_7_XAF=2500
PREMIUM_PRICE_DAYS_30_XAF=7000
BOOST_PRICE_60_MINUTES_XAF=500

# Facultatif pendant le lancement en paiement manuel
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Facultatif tant que CamPay n'est pas activé en production
CAMPAY_BASE_URL=
CAMPAY_ACCESS_TOKEN=
CAMPAY_WEBHOOK_SECRET=

# Nombre de jours avant validation automatique d'une commission
AMBASSADOR_COMMISSION_APPROVAL_DELAY_DAYS=7
